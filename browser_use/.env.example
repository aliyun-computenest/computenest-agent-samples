# 复制本文件为 .env 并按需填写实际值
# cp .env.example .env

# ========== 模型 API Key ==========
# DASHSCOPE_API_KEY=your_dashscope_api_key


# ========== AgentRun Sandbox ==========
# AgentRun 账号 ID，用于构造 CDP / VNC URL
# AGENTRUN_ACCOUNT_ID=your_account_id

# AgentRun 服务区域，默认 cn-hangzhou
# AGENTRUN_REGION=cn-hangzhou

# AgentRun Sandbox 模板名称
# AGENTRUN_TEMPLATE_ID=sandbox-browser-xxxxx

# ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret


# ========== 会话存储（二选一） ==========
# 会话类型由环境变量 SESSION_TYPE 控制，可选 "json" | "redis"
# json = 本地 JSON 文件，redis = Redis，不设置时默认为 json
# SESSION_TYPE=json

# 当 SESSION_TYPE=redis 时必填 Redis 连接 URL
# SESSION_REDIS_URL=redis://localhost:6379/0
# 阿里云 Redis 示例：SESSION_REDIS_URL=redis://:你的密码@实例ID.redis.rds.aliyuncs.com:6379/0


