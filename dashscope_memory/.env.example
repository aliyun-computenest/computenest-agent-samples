# dashscope_memory：cp .env.example .env

# —— 必填 ——
# 不配置则无法访问模型与记忆服务；配置则使用该校验百炼接口
DASHSCOPE_API_KEY=

# —— 可选 ——
# 不配置→走百炼默认记忆库；配置→读写指定记忆库
# BAILIAN_MEMORY_LIBRARY_ID=
# 不配置→不启用控制台绑定的记忆规则；配置→按该 project 的规则存取记忆
# BAILIAN_MEMORY_PROJECT_ID=
# 不配置→本示例不拉画像、写入也不关联画像；配置→可查画像且写入时可填充画像维度
# BAILIAN_MEMORY_PROFILE_SCHEMA=

# DASHSCOPE_MODEL_NAME=qwen-max
# 模型调用若异常，main.py 内会自动以 multimodality 重试整次（仅一次）。
# HTTP 根域名见 DashScope 官方：DASHSCOPE_HTTP_BASE_URL
# SESSION_TYPE=json
# SESSION_REDIS_URL=redis://localhost:6379/0
