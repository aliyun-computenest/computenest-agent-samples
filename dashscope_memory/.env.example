# dashscope_memory: cp .env.example .env

# Required: model and Bailian memory API key.
# Used by both the Qwen model and Bailian long-term memory API.
DASHSCOPE_API_KEY=

# Bailian long-term memory configuration.
BAILIAN_MEMORY_LIBRARY_ID=

# Optional: comma-separated project ids for memory search.
# BAILIAN_MEMORY_SEARCH_PROJECT_IDS=

# Optional: Bailian user-profile schema id.
# When set, new conversations update the profile and the agent loads it before answering.
# BAILIAN_MEMORY_PROFILE_SCHEMA=

DASHSCOPE_MODEL_NAME=qwen-max
# QWEN_MODEL=qwen-plus
BAILIAN_MEMORY_TOP_K=8
BAILIAN_MEMORY_MIN_SCORE=0.25
# BAILIAN_MEMORY_ENDPOINT=https://dashscope.aliyuncs.com/api/v2/apps/memory

# Optional: Redis session persistence, same as samples/conversation.
# SESSION_REDIS_URL=redis://127.0.0.1:6379

PORT=8000
LOG_LEVEL=INFO

# Optional: override the ADK executable.
# ADK_BIN=/path/to/.venv/bin/adk
