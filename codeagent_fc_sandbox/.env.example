# 计算巢用户配置：模型凭证必填，模型名可选。
DASHSCOPE_API_KEY=
DASHSCOPE_MODEL_NAME=qwen3.7-max
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/apps/anthropic

# FC Agent Sandbox 客户配置。
E2B_API_KEY=
FC_E2B_REGION=cn-beijing
FC_E2B_TIMEOUT_MS=1800000
FC_E2B_REQUEST_TIMEOUT_MS=120000
FC_RUNTIME_IDLE_MS=600000

# 可选 OSS 持久化；关闭时沙箱回收后 workspace 和 Claude Session 不恢复。
FC_OSS_PERSISTENCE_ENABLED=false
FC_OSS_BUCKET=
FC_OSS_ENDPOINT=
FC_OSS_ROLE_ARN=
FC_OSS_ROOT_PREFIX=/codeagent/v2

# 控制面与 Preview Gateway。
HOST=127.0.0.1
PORT=8000
PREVIEW_SCHEME=http
PREVIEW_GATEWAY_PORT=5184
CODEAGENT_DATA_DIR=data
