# 复制本文件为 .env 并按需填写实际值
# cp .env.example .env

# ========== 模型与能力（必填） ==========
# 阿里云 DashScope API Key；用于模型、知识库/长期记忆嵌入，以及 MCP 高德服务鉴权
# DASHSCOPE_API_KEY=sk-xxx

# 对话模型，不设置时默认 qwen-max
# DASHSCOPE_MODEL_NAME=qwen-max

# ========== 长期记忆（可选） ==========
# 设为 1 / true / yes 时启用 Mem0 长期记忆（需 DashScope）
# TRAVEL_PLANNER_USE_LONG_TERM_MEMORY=

# ========== 会话存储（二选一） ==========
# 会话类型由环境变量 SESSION_TYPE 控制，可选 "json" | "redis"
# json = 本地 JSON 文件，redis = Redis，不设置时默认为 json
# SESSION_TYPE=json

# 当 SESSION_TYPE=redis 时必填 Redis 连接 URL
# SESSION_REDIS_URL=redis://localhost:6379/0
# 阿里云 Redis 示例：SESSION_REDIS_URL=redis://:你的密码@实例ID.redis.rds.aliyuncs.com:6379/0
