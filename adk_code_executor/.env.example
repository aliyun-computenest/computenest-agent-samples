# DashScope / 百炼配置
DASHSCOPE_API_KEY=your_dashscope_api_key_here
DASHSCOPE_MODEL_NAME=qwen3-plus

# ─── 沙箱后端选择 ────────────────────────────────────────────────
# 以下两种模式二选一，程序启动时会根据环境变量自动判断：
# - E2B_API_KEY 存在 → 使用 E2B 沙箱（ACSSandbox 私有化部署）
# - AGENTRUN_ACCOUNT_ID 存在 → 使用 AgentRun 沙箱（阿里云公有云沙箱服务）
# - 两者均不存在 → 启动报错
# ────────────────────────────────────────────────────────────────

# ─── E2B 模式（需同时设置以下 4 个变量）──────────────────────────
# E2B_API_KEY=your_e2b_api_key_here
# E2B_DOMAIN=agent-vpc.infra
# TEMPLATE_NAME=code-interpreter

# ─── AgentRun 模式（需同时设置以下 5 个变量）─────────────────────
# ALIBABA_CLOUD_ACCESS_KEY_ID=your_access_key_id_here
# ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_access_key_secret_here
# AGENTRUN_REGION=cn-hangzhou
# AGENTRUN_ACCOUNT_ID=your_account_id_here
# TEMPLATE_NAME=code-interpreter

# 可选：Redis 会话存储（不设置则使用 ADK 内存会话）
# SESSION_REDIS_URL=redis://localhost:6379/0

# 可选：TLS 证书（ACSSandbox 私有化部署时由容器入口脚本自动安装）
# 仅在 E2B 模式下必须设置
# TLS_CERT=-----BEGIN CERTIFICATE-----
# ...
# -----END CERTIFICATE-----
